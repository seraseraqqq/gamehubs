  "narrative": {
    "northStar": "Game-first slate stage",
    "overview": "This names the implemented direction rather than an approved concept. The site surrounds a large external Unity player with dark slate, warm ivory text, and amber actions. Compact page controls support play; instructional prose follows the player in a quieter tone.\n\nThe system belongs to this local static site. The cross-origin game's artwork, interface, loading progress, and input behavior are outside its visual ownership. Source evidence is `style.css`, `index.html`, and `app.js`, reconciled with `PRODUCT.md` and the research direction contract. There is no approved comp or concept seed. This document records the build without certifying runtime behavior or release readiness.",
    "keyCharacteristics": [
      "Dark tonal framing with restrained amber emphasis.",
      "Self-hosted Figtree and compact, sentence-case controls.",
      "A dominant player, visible keyboard instructions, and flat supporting content.",
      "Geometric SVG marks and CSS disclosure indicators."
    ],
    "rules": [
      {
        "name": "The Action Amber Rule",
        "body": "Use amber for actionable or orienting elements, following the existing controls, links, focus, and disclosure patterns.",
        "section": "colors"
      },
      {
        "name": "The Player First Rule",
        "body": "Keep page controls next to the player and instructional content below it, preserving the implemented reading order.",
        "section": "layout"
      }
    ],
    "dos": [
      "Do use the local Figtree font and retain its license when reusing the asset.",
      "Do preserve amber keyboard focus and the existing geometric indicator language.",
      "Do keep control labels literal and keyboard instructions accurate.",
      "Do distinguish the host page's visual system from the external game's interface."
    ],
    "donts": [
